# Prevent caching of dynamic page routes (URLs without extensions, HTML, and JSON files)
# This ensures visitors always receive the latest HTML referencing the correct CSS/JS chunk names.
<IfModule mod_headers.c>
    # If the request is NOT for a static asset, disable LiteSpeed and browser caching
    SetEnvIf Request_URI "\.(js|css|gif|png|jpe?g|ico|svg|webp|woff|woff2|xml|webmanifest)$" IS_STATIC
    
    Header set Cache-Control "no-cache, no-store, must-revalidate" env=!IS_STATIC
    Header set Pragma "no-cache" env=!IS_STATIC
    Header set Expires "0" env=!IS_STATIC
    Header set X-LiteSpeed-Cache-Control "no-cache" env=!IS_STATIC

    # Cache static assets (CSS, JS, images, fonts) for 1 year
    # These are hashed in Next.js builds, so their names change when contents change
    <FilesMatch "\.(css|js|woff|woff2|png|jpe?g|gif|ico|svg|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Except logo files, which do not have hashed filenames. Cache them for less time.
    <FilesMatch "(logo|logo_dark)\.webp$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>

# Custom 404 page fallback routing for Apache
ErrorDocument 404 /404.html
