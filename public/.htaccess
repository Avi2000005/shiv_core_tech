# Disable LiteSpeed Cache and browser cache for HTML and JSON files
# This ensures that visitors always get the latest HTML referencing the correct CSS/JS chunk names
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm|json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
        Header set X-LiteSpeed-Cache-Control "no-cache"
    </FilesMatch>

    # Cache static assets (CSS, JS, images, fonts) for 1 year
    # These are hashed in Next.js builds, so their names change when contents change
    <FilesMatch "\.(css|js|woff|woff2|png|jpe?g|gif|ico|svg|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Except logo files, which do not have hashed filenames. Cache them for less time.
    <FilesMatch "(logo|logo_dark)\.webp$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>

# Custom 404 page fallback routing for Apache
ErrorDocument 404 /404.html
